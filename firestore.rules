rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One rule covers every store under a user's own subtree
    // (users/{uid}/tripLegs/{id}, users/{uid}/transactions/{id}, ...),
    // so adding a new store never needs a rules change.
    match /users/{uid}/{store}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
